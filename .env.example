# Example environment variables
# Choose LLM provider: 'openai' or 'gemini'
LLM_PROVIDER=gemini

# For Google Gemini (default)
# Obtain an API key and set one of these (GEMINI_API_KEY preferred)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=models/text-bison-001

LLM_TEMPERATURE=0.2
MAX_CHAPTER_RETRIES=2

# Optional testing helper: set DRY_RUN=1 to run without real LLM or pdflatex
# DRY_RUN=1
